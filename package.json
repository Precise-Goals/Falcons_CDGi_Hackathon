{
  "name": "intra-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Infrastructure that lets software survive undocumented changes in external services",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:int": "turbo run test:int",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "demo": "bun scripts/demo.mjs",
    "serve": "bun scripts/serve.mjs",
    "dev": "bun --filter @intra/web dev",
    "flutter:dev": "adb reverse tcp:3001 tcp:3001 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:3002 tcp:3002 && flutter run -d android",
    "flutter:test": "flutter test",
    "flutter:devices": "flutter devices"
  },
  "dependencies": {
    "@intra/adapter": "workspace:*",
    "@intra/differ": "workspace:*",
    "@intra/impact": "workspace:*",
    "@intra/model": "workspace:*",
    "@intra/observer": "workspace:*",
    "@intra/sdk": "workspace:*",
    "@intra/shared": "workspace:*",
    "@intra/sim-services": "workspace:*",
    "@intra/validator": "workspace:*",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^3.0.7",
    "dotenv": "^18.0.7",
    "ethers": "^6.17.0",
    "solc": "^0.8.37",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@9.15.4"
}
