    "typecheck": "turbo run typecheck",
    "demo": "bun scripts/demo.mjs",
    "serve": "bun scripts/serve.mjs",
    "dev": "bun --filter @intra/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
