{
  "name": "intra-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Infrastructure that lets software survive undocumented changes in external services",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
