{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "api",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
