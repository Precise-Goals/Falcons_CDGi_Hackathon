{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/mcp/tools/call",
      "destination": "/api/mcp/tools/call.js"
    },
    {
      "source": "/api/mcp/(.*)",
      "destination": "/api/mcp/$1.js"
    },
    {
      "source": "/api/engine/(.*)",
      "destination": "/api/engine/$1.js"
    },
    {
      "source": "/api/sim/(.*)",
      "destination": "/api/sim/$1.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
