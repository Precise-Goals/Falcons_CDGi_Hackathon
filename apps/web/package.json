{
  "name": "@intra/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @intra/shared --filter @intra/model --filter @intra/differ --filter @intra/impact --filter @intra/adapter --filter @intra/validator --filter @intra/sdk run build",
    "build": "tsc && vite build && node scripts/copy-spa-html.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@intra/adapter": "workspace:*",
    "@intra/differ": "workspace:*",
    "@intra/impact": "workspace:*",
    "@intra/model": "workspace:*",
    "@intra/sdk": "workspace:*",
    "@intra/shared": "workspace:*",
    "@intra/validator": "workspace:*",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
